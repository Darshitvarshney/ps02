{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "dist/**"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path=/api"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path=/openapi.json"
    },
    {
      "source": "/(.*)",
      "destination": "/api/index.py?__path=/$1"
    }
  ]
}
